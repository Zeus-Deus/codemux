{
  "name": "codemux-claude-agent-sidecar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node sidecar for Codemux's Claude provider.",
  "scripts": {
    "build": "bun build --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --target=bun-linux-x64 --outfile=dist/codemux-claude-sidecar src/main.ts",
    "typecheck": "tsc --noEmit",
    "check-tos": "bash scripts/check-tos-boundary.sh",
    "test": "bun test && bun run check-tos"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.114"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.22"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
