{
  "name": "codemux-claude-agent-sidecar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node sidecar for Codemux's Claude provider.",
  "scripts": {
    "build": "bun build --compile --target=bun-linux-x64 --outfile=dist/codemux-claude-sidecar src/main.ts",
    "build:all": "bun run build:linux-x64 && bun run build:linux-arm64 && bun run build:darwin-x64 && bun run build:darwin-arm64",
    "build:linux-x64": "bun build --compile --target=bun-linux-x64 --outfile=dist/codemux-claude-sidecar-linux-x64 src/main.ts",
    "build:linux-arm64": "bun build --compile --target=bun-linux-arm64 --outfile=dist/codemux-claude-sidecar-linux-arm64 src/main.ts",
    "build:darwin-x64": "bun build --compile --target=bun-darwin-x64 --outfile=dist/codemux-claude-sidecar-darwin-x64 src/main.ts",
    "build:darwin-arm64": "bun build --compile --target=bun-darwin-arm64 --outfile=dist/codemux-claude-sidecar-darwin-arm64 src/main.ts",
    "build:windows-x64": "bun build --compile --target=bun-windows-x64 --outfile=dist/codemux-claude-sidecar-windows-x64.exe src/main.ts",
    "typecheck": "tsc --noEmit",
    "check-tos": "bash scripts/check-tos-boundary.sh",
    "test": "bun test && bun run check-tos"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.114"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
