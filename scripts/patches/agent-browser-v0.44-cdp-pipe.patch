+const CHROME_PIPE_STARTUP_BUDGET: Duration = Duration::from_secs(20);
+const CHROME_PIPE_RETRY_DELAY: Duration = Duration::from_millis(500);
+const CHROME_PIPE_CLEANUP_MARGIN: Duration = Duration::from_secs(2);
+
+enum PipeAttemptError {
+    Retry(String),
+    Stop(String),
+}
+
+async fn launch_managed_chrome_attempt(
+    options: LaunchOptions,
+    deadline: Instant,
+) -> Result<(BrowserProcess, Arc<CdpClient>), PipeAttemptError> {
+    let mut launch_task = tokio::task::spawn_blocking(move || launch_chrome(&options));
+    let mut chrome = match tokio::time::timeout_at(deadline.into(), &mut launch_task).await {
+        Ok(Ok(Ok(chrome))) => chrome,
+        Ok(Ok(Err(error))) => return Err(PipeAttemptError::Retry(error)),
+        Ok(Err(error)) => {
+            return Err(PipeAttemptError::Retry(format!(
+                "Chrome launch task failed: {error}"
+            )))
+        }
+        Err(_) => {
+            // spawn_blocking cannot be cancelled. Do not overlap a retry with
+            // this launch; reap its child if it eventually returns one.
+            tokio::spawn(async move {
+                if let Ok(Ok(chrome)) = launch_task.await {
+                    drop(chrome);
+                }
+            });
+            return Err(PipeAttemptError::Stop(
+                "Chrome pipe launch exceeded its startup deadline".to_string(),
+            ));
+        }
+    };
+    let (reader, writer) = chrome.take_pipe().map_err(PipeAttemptError::Retry)?;
+    let chrome = Arc::new(StdMutex::new(chrome));
+    let weak_chrome = Arc::downgrade(&chrome);
+    let on_failure: Arc<dyn Fn() + Send + Sync> = Arc::new(move || {
+        if let Some(chrome) = weak_chrome.upgrade() {
+            chrome
+                .lock()
+                .unwrap_or_else(|error| error.into_inner())
+                .kill();
+        }
+    });
+    let client = Arc::new(CdpClient::connect_pipe(reader, writer, Some(on_failure)));
+
+    // A successful spawn does not prove Chromium accepted its private pipe.
+    let readiness_budget = deadline
+        .saturating_duration_since(Instant::now())
+        .saturating_sub(CHROME_PIPE_CLEANUP_MARGIN)
+        .min(Duration::from_secs(10));
+    let ready = tokio::time::timeout(
+        readiness_budget,
+        client.send_command_no_params("Browser.getVersion", None),
+    )
+    .await;
+    if matches!(ready, Ok(Ok(_))) {
+        return Ok((BrowserProcess::Chrome(chrome), client));
+    }
+
+    let exited = {
+        let mut process = chrome.lock().unwrap_or_else(|error| error.into_inner());
+        let exited = process.has_exited();
+        process.kill();
+        exited
+    };
+    client.close().await;
+    tokio::time::sleep(Duration::from_millis(25)).await;
+    let stderr = chrome
+        .lock()
+        .unwrap_or_else(|error| error.into_inner())
+        .stderr_tail();
+    let diagnostic = if stderr.is_empty() {
+        String::new()
+    } else {
+        format!("; Chrome stderr tail: {stderr}")
+    };
+    Err(PipeAttemptError::Retry(format!(
+        "Chrome pipe did not become ready: {ready:?}; process exited: {exited}{diagnostic}"
+    )))
+}
+
+async fn launch_managed_chrome(
+    options: LaunchOptions,
+) -> Result<(BrowserProcess, Arc<CdpClient>), String> {
+    launch_managed_chrome_with_budget(options, CHROME_PIPE_STARTUP_BUDGET).await
+}
+
+async fn launch_managed_chrome_with_budget(
+    options: LaunchOptions,
+    startup_budget: Duration,
+) -> Result<(BrowserProcess, Arc<CdpClient>), String> {
+    const MAX_ATTEMPTS: usize = 3;
+    let deadline = Instant::now() + startup_budget;
+    let mut last_error = String::new();
+    for attempt in 1..=MAX_ATTEMPTS {
+        let remaining_attempts = MAX_ATTEMPTS - attempt + 1;
+        let remaining = deadline.saturating_duration_since(Instant::now());
+        let reserved_backoffs = CHROME_PIPE_RETRY_DELAY * (remaining_attempts - 1) as u32;
+        let attempt_budget =
+            remaining.saturating_sub(reserved_backoffs) / remaining_attempts as u32;
+        if attempt_budget < Duration::from_millis(100) {
+            break;
+        }
+        let attempt_deadline = Instant::now() + attempt_budget;
+        match launch_managed_chrome_attempt(options.clone(), attempt_deadline).await {
+            Ok(launched) => return Ok(launched),
+            Err(PipeAttemptError::Retry(error)) => last_error = error,
+            Err(PipeAttemptError::Stop(error)) => return Err(error),
+        }
+        if attempt < MAX_ATTEMPTS {
+            if deadline.saturating_duration_since(Instant::now()) <= CHROME_PIPE_RETRY_DELAY {
+                break;
+            }
+            let _ = writeln!(
+                std::io::stderr(),
+                "[chrome] Launch attempt {attempt}/{MAX_ATTEMPTS} failed, retrying in 500ms..."
+            );
+            tokio::time::sleep(CHROME_PIPE_RETRY_DELAY).await;
+        }
+    }
+    if last_error.is_empty() {
+        Err("Chrome pipe startup deadline expired before another attempt".to_string())
+    } else {
+        Err(last_error)
+    }
+}
