+                        return None;
+                    }
+                    Ok(Message::Pong(_)) | Ok(_) => continue,
+                    Err(error) => {
+                        if std::env::var("AGENT_BROWSER_DEBUG").is_ok() {
+                            let _ = writeln!(std::io::stderr(), "[cdp] WebSocket Error: {error}");
+                        }
+                        return None;
+                    }
+                }
+            },
+            Self::Pipe(pipe) => {
+                let mut message = Vec::new();
+                loop {
