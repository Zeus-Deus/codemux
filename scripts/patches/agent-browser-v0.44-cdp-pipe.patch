+pub(super) const CHROME_PIPE_STARTUP_BUDGET: Duration = Duration::from_secs(20);
+const CHROME_PIPE_RETRY_DELAY: Duration = Duration::from_millis(500);
+const CHROME_PIPE_CLEANUP_MARGIN: Duration = Duration::from_secs(2);
+
+enum PipeAttemptError {
+    Retry(String),
+    Stop(String),
+}
+
+struct ChromeSpawnOutcome {
+    // Drop the child before the prepared profile if a cancelled join discards
+    // the result. A late child must not outlive its copied profile.
+    process: Result<ChromeProcess, String>,
+    _prepared: Arc<PreparedChromeLaunch>,
+}
+
+struct CancelPendingChromeSpawn(Arc<AtomicBool>);
+
+impl Drop for CancelPendingChromeSpawn {
+    fn drop(&mut self) {
+        self.0.store(true, Ordering::Release);
+    }
+}
+
+async fn launch_managed_chrome_attempt(
+    prepared: Arc<PreparedChromeLaunch>,
+    deadline: Instant,
+) -> Result<(BrowserProcess, Arc<CdpClient>), PipeAttemptError> {
+    let spawn_deadline = deadline - CHROME_PIPE_CLEANUP_MARGIN;
+    let cancel = Arc::new(AtomicBool::new(false));
+    let _cancel_on_drop = CancelPendingChromeSpawn(cancel.clone());
+    let worker_prepared = prepared.clone();
+    let worker_cancel = cancel.clone();
+    let mut launch_task = tokio::task::spawn_blocking(move || ChromeSpawnOutcome {
+        process: worker_prepared.spawn_guarded(&worker_cancel, spawn_deadline),
+        _prepared: worker_prepared,
+    });
+    let mut chrome = match tokio::time::timeout_at(spawn_deadline.into(), &mut launch_task).await {
+        Ok(Ok(outcome)) => outcome.process.map_err(PipeAttemptError::Retry)?,
+        Ok(Err(error)) => {
+            return Err(PipeAttemptError::Retry(format!(
+                "Chrome launch task failed: {error}"
+            )))
+        }
+        Err(_) => {
+            cancel.store(true, Ordering::Release);
+            // spawn_blocking cannot be cancelled. Keep profile ownership with
+            // its result until any late child is dropped and reaped.
+            tokio::spawn(async move {
+                let _ = launch_task.await;
+            });
+            return Err(PipeAttemptError::Stop(
+                "Chrome pipe launch exceeded its startup deadline".to_string(),
+            ));
+        }
+    };
+    let (reader, writer) = chrome.take_pipe().map_err(PipeAttemptError::Retry)?;
+    let chrome = Arc::new(StdMutex::new(chrome));
+    let weak_chrome = Arc::downgrade(&chrome);
+    let on_failure: Arc<dyn Fn() + Send + Sync> = Arc::new(move || {
+        if let Some(chrome) = weak_chrome.upgrade() {
+            chrome
+                .lock()
+                .unwrap_or_else(|error| error.into_inner())
+                .kill();
+        }
+    });
+    let client = Arc::new(CdpClient::connect_pipe(reader, writer, Some(on_failure)));
+
+    // A successful spawn does not prove Chromium accepted its private pipe.
+    // A live Chromium can take longer than one equal retry slice to accept
+    // the pipe, especially on loaded Windows runners. Retry promptly when it
+    // exits or fails; otherwise give this child most of the shared deadline.
+    let readiness_budget = deadline
+        .saturating_duration_since(Instant::now())
+        .saturating_sub(CHROME_PIPE_CLEANUP_MARGIN)
+        .min(Duration::from_secs(15));
+    let ready = tokio::time::timeout(
+        readiness_budget,
+        client.send_command_no_params("Browser.getVersion", None),
+    )
+    .await;
+    if matches!(ready, Ok(Ok(_))) {
+        return Ok((BrowserProcess::Chrome(chrome), client));
+    }
+
+    let exited = {
+        let mut process = chrome.lock().unwrap_or_else(|error| error.into_inner());
+        let exited = process.has_exited();
+        process.kill();
+        exited
+    };
+    client.close().await;
+    tokio::time::sleep(Duration::from_millis(25)).await;
+    let stderr = chrome
+        .lock()
+        .unwrap_or_else(|error| error.into_inner())
+        .stderr_tail();
+    let diagnostic = if stderr.is_empty() {
+        String::new()
+    } else {
+        format!("; Chrome stderr tail: {stderr}")
+    };
+    Err(PipeAttemptError::Retry(format!(
+        "Chrome pipe did not become ready: {ready:?}; process exited: {exited}{diagnostic}"
+    )))
+}
