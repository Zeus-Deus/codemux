+#[cfg(test)]
+async fn launch_managed_chrome_with_budget_and_prepare<F>(
+    options: LaunchOptions,
+    startup_budget: Duration,
+    prepare: F,
+) -> Result<(BrowserProcess, Arc<CdpClient>), String>
+where
+    F: FnOnce(&LaunchOptions) -> Result<PreparedChromeLaunch, String> + Send + 'static,
+{
+    launch_managed_chrome_until_with_prepare(options, Instant::now() + startup_budget, prepare)
+        .await
+}
+
+async fn launch_managed_chrome_until_with_prepare<F>(
+    options: LaunchOptions,
+    deadline: Instant,
+    prepare: F,
+) -> Result<(BrowserProcess, Arc<CdpClient>), String>
+where
+    F: FnOnce(&LaunchOptions) -> Result<PreparedChromeLaunch, String> + Send + 'static,
+{
+    const MAX_ATTEMPTS: usize = 3;
+    let prepare_deadline = deadline - CHROME_PIPE_CLEANUP_MARGIN;
+    let mut prepare_task = tokio::task::spawn_blocking(move || prepare(&options));
+    let prepared = match tokio::time::timeout_at(prepare_deadline.into(), &mut prepare_task).await {
+        Ok(Ok(Ok(prepared))) => Arc::new(prepared),
+        Ok(Ok(Err(error))) => return Err(error),
+        Ok(Err(error)) => return Err(format!("Chrome preparation task failed: {error}")),
+        Err(_) => {
+            // This worker only prepares launch options. If it finishes late,
+            // dropping its result cleans the copied profile without spawning.
+            tokio::spawn(async move {
+                let _ = prepare_task.await;
+            });
+            return Err("Chrome pipe launch preparation exceeded its startup deadline".into());
+        }
+    };
+    let mut last_error = String::new();
+    for attempt in 1..=MAX_ATTEMPTS {
+        let remaining = deadline.saturating_duration_since(Instant::now());
+        if remaining <= CHROME_PIPE_CLEANUP_MARGIN + Duration::from_millis(100) {
+            break;
+        }
+        match launch_managed_chrome_attempt(prepared.clone(), deadline).await {
+            Ok((mut process, client)) => {
+                let mut owner = match Arc::try_unwrap(prepared) {
+                    Ok(owner) => owner,
+                    Err(_) => {
+                        process.kill();
+                        client.close().await;
+                        return Err("Chrome launch preparation remained in use".into());
+                    }
+                };
+                if let BrowserProcess::Chrome(chrome) = &mut process {
+                    owner.adopt_profile(&mut chrome.lock().unwrap_or_else(|e| e.into_inner()));
+                }
+                return Ok((process, client));
+            }
+            Err(PipeAttemptError::Retry(error)) => last_error = error,
+            Err(PipeAttemptError::Stop(error)) => return Err(error),
+        }
+        if attempt < MAX_ATTEMPTS {
+            if deadline.saturating_duration_since(Instant::now()) <= CHROME_PIPE_RETRY_DELAY {
+                break;
+            }
+            let _ = writeln!(
+                std::io::stderr(),
+                "[chrome] Launch attempt {attempt}/{MAX_ATTEMPTS} failed, retrying in 500ms..."
+            );
+            tokio::time::sleep(CHROME_PIPE_RETRY_DELAY).await;
+        }
+    }
+    if last_error.is_empty() {
+        Err("Chrome pipe startup deadline expired before another attempt".to_string())
+    } else {
+        Err(last_error)
+    }
+}
