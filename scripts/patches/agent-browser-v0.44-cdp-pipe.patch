+
+impl TransportWriter {
+    async fn send_text(&mut self, text: String) -> Result<(), String> {
+        match self {
+            Self::WebSocket(socket) => socket
+                .send(Message::Text(text))
+                .await
+                .map_err(|e| e.to_string()),
+            Self::Pipe(pipe) => {
+                pipe.write_all(text.as_bytes())
+                    .await
+                    .map_err(|e| e.to_string())?;
+                pipe.write_all(&[0]).await.map_err(|e| e.to_string())?;
+                pipe.flush().await.map_err(|e| e.to_string())
+            }
+        }
+    }
+
+    async fn close(&mut self) {
+        match self {
+            Self::WebSocket(socket) => {
+                let _ = socket.close().await;
+            }
+            Self::Pipe(pipe) => {
+                let _ = pipe.shutdown().await;
+            }
+        }
+    }
+
+    async fn ping(&mut self) -> Result<(), String> {
+        match self {
+            Self::WebSocket(socket) => socket
+                .send(Message::Ping(Vec::new()))
+                .await
+                .map_err(|e| e.to_string()),
+            Self::Pipe(_) => Ok(()),
+        }
+    }
+}
+
+type TransportTx = Arc<Mutex<TransportWriter>>;
+
+enum TransportReader {
+    WebSocket(futures_util::stream::SplitStream<CdpWebSocket>),
+    Pipe(BufReader<tokio::fs::File>),
+}
+
+const MAX_PIPE_MESSAGE_BYTES: usize = 100 * 1024 * 1024;
+
+impl TransportReader {
+    async fn next_text(&mut self) -> Option<String> {
+        match self {
+            Self::WebSocket(socket) => loop {
+                match socket.next().await? {
+                    Ok(Message::Text(text)) => return Some(text),
+                    Ok(Message::Binary(data)) => {
+                        if let Ok(text) = String::from_utf8(data) {
+                            return Some(text);
+                        }
+                    }
+                    Ok(Message::Close(frame)) => {
+                        if std::env::var("AGENT_BROWSER_DEBUG").is_ok() {
+                            let reason = frame
+                                .as_ref()
+                                .map(|f| format!("code={}, reason={}", f.code, f.reason))
+                                .unwrap_or_else(|| "no frame".to_string());
+                            let _ = writeln!(std::io::stderr(), "[cdp] WebSocket Close: {reason}");
+                        }
+                        return None;
+                    }
+                    Ok(Message::Pong(_)) | Ok(_) => continue,
+                    Err(error) => {
+                        if std::env::var("AGENT_BROWSER_DEBUG").is_ok() {
+                            let _ = writeln!(std::io::stderr(), "[cdp] WebSocket Error: {error}");
+                        }
+                        return None;
+                    }
+                }
+            },
+            Self::Pipe(pipe) => {
+                let mut message = Vec::new();
+                loop {
+                    let available = pipe.fill_buf().await.ok()?;
+                    if available.is_empty() {
+                        return None;
+                    }
+                    let end = available.iter().position(|byte| *byte == 0);
+                    let count = end.map_or(available.len(), |position| position + 1);
+                    if message.len().saturating_add(count) > MAX_PIPE_MESSAGE_BYTES {
+                        return None;
+                    }
+                    message.extend_from_slice(&available[..count]);
+                    pipe.consume(count);
+                    if end.is_some() {
+                        message.pop();
+                        return String::from_utf8(message).ok();
+                    }
+                }
+            }
+        }
+    }
