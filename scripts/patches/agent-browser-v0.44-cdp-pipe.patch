+    }
+    my $result = $method eq "Target.getTargets" ? q({"targetInfos":[]})
+        : $method eq "Target.createTarget" ? q({"targetId":"page-1"})
+        : $method eq "Target.attachToTarget" ? q({"sessionId":"session-1"})
+        : q({});
