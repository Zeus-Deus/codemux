+        fs::set_permissions(&executable, fs::Permissions::from_mode(0o700)).unwrap();
+        let previous_executable = json!(dir.path().join("previous-chrome"));
+        let previous_profile = json!(dir.path().join("previous-profile"));
+        let next_profile = dir.path().join("next-profile");
