+                    if available.is_empty() {
+                        return None;
+                    }
+                    let end = available.iter().position(|byte| *byte == 0);
+                    let count = end.map_or(available.len(), |position| position + 1);
+                    if message.len().saturating_add(count) > MAX_PIPE_MESSAGE_BYTES {
+                        return None;
+                    }
+                    message.extend_from_slice(&available[..count]);
