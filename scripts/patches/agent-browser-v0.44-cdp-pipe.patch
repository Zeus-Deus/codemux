+fn read_regular_file(path: &str) -> io::Result<Vec<u8>> {
+    let mut options = fs::OpenOptions::new();
+    options.read(true);
+    // A FIFO can block in open() before its type can be checked. Keep the
+    // worker interruptible while preserving ordinary symlinked files.
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.custom_flags(libc::O_NONBLOCK);
+    }
+    let file = options.open(path)?;
+    let metadata = file.metadata()?;
+    if !metadata.is_file() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "expected a regular file",
+        ));
+    }
+    if metadata.len() > MAX_STARTUP_FILE_BYTES {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "file exceeds 64 MiB startup limit",
+        ));
+    }
+    let mut data = Vec::new();
+    file.take(MAX_STARTUP_FILE_BYTES + 1)
+        .read_to_end(&mut data)?;
+    if data.len() as u64 > MAX_STARTUP_FILE_BYTES {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "file exceeds 64 MiB startup limit",
+        ));
+    }
+    Ok(data)
+}
+
+pub(super) fn read_regular_file_to_string(path: &str) -> io::Result<String> {
+    String::from_utf8(read_regular_file(path)?)
+        .map_err(|error| io::Error::new(io::ErrorKind::InvalidData, error))
+}
