+            fs::write(dir.path().join("capture"), b"").unwrap();
+            state
+                .settings
+                .set(Key::ExecutablePath, previous_executable.clone());
+            state.settings.set(Key::Profile, previous_profile.clone());
+            state.settings.set(Key::UserAgent, json!("previous-agent"));
+            state.settings.set(Key::Capture, json!(["flow"]));
+            state.session_setup.user_agent = Some("previous-agent".into());
+            state.touch_sessions.insert("previous-touch".into());
