@@ -1438 +1432,11 @@ fn send_command_once(cmd: &Value, session: &str) -> Result<Response, SendError>
-    let mut json_str = serde_json::to_string(cmd).map_err(|e| SendError::NotSent(e.to_string()))?;
+    if !daemon_version_matches(session) {
