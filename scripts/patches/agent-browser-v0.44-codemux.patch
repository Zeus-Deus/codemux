@@ -0,0 +1,33 @@
+//! Codemux's private sidecar protocol. A token is supplied only through the
+//! parent process environment and never persisted in a session URL or file.
+
+use std::sync::OnceLock;
+
+pub const HEADER: &str = "x-codemux-browser-token";
+pub const FIELD: &str = "codemuxToken";
+pub const BUILD_VERSION: &str = concat!(env!("CARGO_PKG_VERSION"), "+codemux.1");
+
+pub fn expected_token() -> Option<&'static str> {
+    static TOKEN: OnceLock<Option<String>> = OnceLock::new();
+    TOKEN
+        .get_or_init(|| {
+            let token = std::env::var("CODEMUX_BROWSER_SECRET").ok()?;
+            (token.len() == 64 && token.bytes().all(|byte| byte.is_ascii_hexdigit()))
+                .then_some(token)
+        })
+        .as_deref()
+}
+
+pub fn token_matches(candidate: Option<&str>) -> bool {
+    let (Some(expected), Some(candidate)) = (expected_token(), candidate) else {
+        return false;
+    };
+    if expected.len() != candidate.len() {
+        return false;
+    }
+    expected
+        .bytes()
+        .zip(candidate.bytes())
+        .fold(0u8, |difference, (left, right)| difference | (left ^ right))
+        == 0
+}
