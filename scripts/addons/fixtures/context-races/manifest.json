{
  "format": "codemux.feature-plugin",
  "manifestVersion": 1,
  "id": "example.context-races",
  "name": "Context Race Fixture",
  "description": "CI-only delayed draft operations used to verify context cancellation in the installed desktop.",
  "version": "1.0.0",
  "api": "^1.0.0",
  "entry": "plugin.js",
  "platforms": ["linux-x64", "windows-x64"],
  "author": {
    "name": "CodeMux CI",
    "url": "https://codemux.org"
  },
  "repository": "https://github.com/Zeus-Deus/codemux",
  "license": "MIT",
  "permissions": ["composer.append"],
  "http": [],
  "credentials": [],
  "settings": [],
  "contributes": {
    "commands": [
      {
        "id": "status",
        "title": "Open context race status",
        "requiresWorkspace": true
      },
      {
        "id": "typing",
        "title": "CI delayed typing",
        "requiresWorkspace": true
      },
      {
        "id": "workspace",
        "title": "CI delayed workspace",
        "requiresWorkspace": true
      },
      {
        "id": "thread",
        "title": "CI delayed thread",
        "requiresWorkspace": true
      },
      {
        "id": "replacement",
        "title": "CI delayed replacement",
        "requiresWorkspace": true
      },
      {
        "id": "disable",
        "title": "CI delayed disable",
        "requiresWorkspace": true
      }
    ],
    "panels": [
      {
        "id": "status",
        "title": "Context race status",
        "icon": "list"
      }
    ],
    "composerActions": [],
    "composerViews": []
  }
}
