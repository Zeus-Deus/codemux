# OS files
.DS_Store
Thumbs.db

# Node/Svelte dependencies and build outputs
node_modules/
build/
.svelte-kit/
dist/
coverage/
package/

# Tauri/Rust build outputs
src-tauri/target/
src-tauri/gen/

# Codemux local project state
.codemux/index.json
.codemux/observability.json
.codemux/project-memory.json
src-tauri/.codemux/

# Ad hoc local patch scripts
/*.cjs

# Local editor/IDE folders
.vscode/

# Local Claude Code settings and runtime state (machine-specific).
# Covers permissions, the ScheduleWakeup lock file, and any other
# transient files the harness drops under .claude/ during a session.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/*.lock

# Environment files (keep template)
.env
.env.*
!.env.example

# TypeScript build cache
*.tsbuildinfo

# Vite temp files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Auto-generated MCP config (points to local build path)
.mcp.json

# External tool worktree state
.superset/

# Logs and local editor temp files
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.swp
*.swo
*~
