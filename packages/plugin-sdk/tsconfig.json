{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"],
    "module": "NodeNext", "moduleResolution": "NodeNext", "strict": true,
    "skipLibCheck": true, "noUncheckedIndexedAccess": true,
    "declaration": true, "outDir": "dist", "rootDir": "src",
    "types": [], "noEmitOnError": true
  },
  "include": ["src/**/*.ts"]
}
